# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real keys.

# SEC EDGAR's fair-access policy asks every automated requester to identify
# itself with a real contact in the User-Agent header. Put your own email here.
SEC_CONTACT_EMAIL=you@example.com

# Free at alpaca.markets -- sign up for a paper trading account, then
# Dashboard > API Keys. Used for both reference data (asset lookups) and,
# in a later phase, the live websocket feed.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional, free at openfigi.com/api. Without it OpenFIGI allows 25
# requests/minute of 10 lookups each -- plenty for ~80 names (a build takes
# ~20s longer). With it: 100 lookups per request, much faster.
OPENFIGI_API_KEY=

# Optional: where the Delta tables live. Defaults to <repo>/data/lakehouse,
# which works both in the container and in a local .venv.
# LAKEHOUSE_ROOT=
